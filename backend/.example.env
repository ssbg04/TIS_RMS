PORT=18484
JWT_SECRET=your_jwt_secret_key_here
DB_PATH=./data/tis_rms.db
UPLOAD_PATH=./uploads
# Root folder where auto-created student directories are stored
STUDENT_DIR_ROOT=./data/students
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Auto Cloudflare Tunnel activation
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

PUBLIC_URL=https://your-domain.example.com/api

# Gmail SMTP Email Service (for Password Reset OTP)
SMTP_USER=your_school_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM="TIS Record Management System" <your_school_email@gmail.com>
DEVELOPER_SUPPORT_EMAIL=support@school.example.edu.ph

# Optional API Keys
GEMINI_API_KEY=your_gemini_api_key_here
MEV_API_KEY=your_mev_api_key

# Initial Admin Seed Credentials (override before first boot in production)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_this_initial_password

# Internal Machine-to-Machine Secret for Server Manager
SERVER_MANAGER_SECRET=your_server_manager_m2m_secret_here
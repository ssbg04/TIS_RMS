                        SELECT e.id FROM enrollments e
                        JOIN teacher_sections ts ON e.section_id = ts.section_id
                        WHERE ts.teacher_id = 4.0
                    ))
                    OR
                    (a.user_id = 4.0)
                )
            
            ORDER BY a.created_at DESC
            LIMIT 5.0 OFFSET 0.0
        

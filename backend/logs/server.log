            SELECT
                a.id, a.action, a.entity_type, a.entity_id, a.description, a.created_at,
                COALESCE(u.username, dh.username, 'System') AS username,
                COALESCE(u.first_name || ' ' || u.last_name, dh.full_name, 'System') AS performed_by
            FROM activity_log a

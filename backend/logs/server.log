                      AND (d.requirement_id = 11.0 OR dr.name = 'PSA Birth Certificate' OR d.document_type = 'PSA Birth Certificate' OR d.document_type = 'SHS - PSA Birth Certificate')
                      AND d.deleted_at IS NULL
                      AND d.status = 'Completed'
                    GROUP BY e.grade_level
                

                    SELECT COUNT(DISTINCT d.student_id) as archived_count
                    FROM documents d
                    JOIN students s ON d.student_id = s.id
                    JOIN enrollments e ON s.id = e.student_id
                    LEFT JOIN document_requirements dr ON d.requirement_id = dr.id
                    WHERE e.section_id IN (SELECT section_id FROM teacher_sections WHERE teacher_id = 4.0)
                      AND e.grade_level BETWEEN 11.0 AND 12.0
                      AND (d.requirement_id = 11.0 OR dr.name = 'PSA Birth Certificate' OR d.document_type = 'PSA Birth Certificate' OR d.document_type = 'SHS - PSA Birth Certificate')
                      AND d.deleted_at IS NULL
                      AND d.status = 'Archived'
                

                    SELECT e.grade_level, COUNT(DISTINCT d.student_id) as uploaded_count
                    FROM documents d
                    JOIN students s ON d.student_id = s.id
                    JOIN enrollments e ON s.id = e.student_id
                    LEFT JOIN document_requirements dr ON d.requirement_id = dr.id
                    WHERE e.section_id IN (SELECT section_id FROM teacher_sections WHERE teacher_id = 4.0)
                      AND e.grade_level BETWEEN 11.0 AND 12.0
                      AND (d.requirement_id = 10.0 OR dr.name = 'Report Card (SF9)' OR d.document_type = 'Report Card (SF9)' OR d.document_type = 'SHS - Report Card (SF9)')
                      AND d.deleted_at IS NULL
                      AND d.status = 'Completed'
                    GROUP BY e.grade_level
                

                    SELECT COUNT(DISTINCT d.student_id) as archived_count
                    FROM documents d
                    JOIN students s ON d.student_id = s.id
                    JOIN enrollments e ON s.id = e.student_id
                    LEFT JOIN document_requirements dr ON d.requirement_id = dr.id
                    WHERE e.section_id IN (SELECT section_id FROM teacher_sections WHERE teacher_id = 4.0)
                      AND e.grade_level BETWEEN 11.0 AND 12.0
                      AND (d.requirement_id = 10.0 OR dr.name = 'Report Card (SF9)' OR d.document_type = 'Report Card (SF9)' OR d.document_type = 'SHS - Report Card (SF9)')
                      AND d.deleted_at IS NULL
                      AND d.status = 'Archived'
                

                SELECT COUNT(DISTINCT d.id) as total
                FROM documents d
                LEFT JOIN students s ON d.student_id = s.id
                LEFT JOIN enrollments e ON e.student_id = s.id
                JOIN teacher_sections ts ON e.section_id = ts.section_id AND ts.teacher_id = 4.0
                WHERE (
                    (s.status IN ('Graduated','Transferred','Dropped','Inactive') AND d.deleted_at IS NULL)
                    OR
                    (s.status = 'Enrolled' AND d.status = 'Archived' AND d.deleted_at IS NULL)
                )
            

                SELECT
                    DATE(d.created_at) as day,
                    COUNT(*) as count
                FROM documents d
                JOIN students s ON d.student_id = s.id
                JOIN enrollments e ON s.id = e.student_id
                WHERE e.section_id IN (SELECT section_id FROM teacher_sections WHERE teacher_id = 4.0)
                  AND DATE(d.created_at) >= DATE('now', '-29 days')
                  AND d.deleted_at IS NULL
                GROUP BY day
                ORDER BY day ASC
            

                SELECT d.file_path, d.document_type,
